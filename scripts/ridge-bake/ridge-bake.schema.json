{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "ridge-bake manifest v2 and index v1",
 "$defs": {
  "manifest": {
   "type": "object",
   "required": [
    "schema",
    "baker_version",
    "bake_id",
    "place",
    "view",
    "max_slide_px",
    "curvature",
    "encoding",
    "cards",
    "w",
    "h",
    "bytes",
    "attribution"
   ],
   "additionalProperties": false,
   "properties": {
    "schema": {
     "const": 2
    },
    "baker_version": {
     "type": "integer"
    },
    "bake_id": {
     "type": "string"
    },
    "place": {
     "type": "object",
     "required": [
      "id",
      "name",
      "lat",
      "lon",
      "altitude_km",
      "eye_m"
     ],
     "additionalProperties": false,
     "properties": {
      "id": {
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "lat": {
       "type": "number"
      },
      "lon": {
       "type": "number"
      },
      "altitude_km": {
       "type": "number"
      },
      "eye_m": {
       "type": "number"
      }
     }
    },
    "view": {
     "type": "object",
     "required": [
      "look_az_deg",
      "window_deg",
      "plane_w",
      "plane_h",
      "px_per_deg_h",
      "px_per_deg_v",
      "exaggeration",
      "horizon_row",
      "sky_row",
      "near_row"
     ],
     "additionalProperties": false,
     "properties": {
      "look_az_deg": {
       "type": "number"
      },
      "window_deg": {
       "const": 72
      },
      "plane_w": {
       "type": "integer",
       "maximum": 4096
      },
      "plane_h": {
       "type": "integer"
      },
      "px_per_deg_h": {
       "type": "number"
      },
      "px_per_deg_v": {
       "type": "number"
      },
      "exaggeration": {
       "type": "number"
      },
      "horizon_row": {
       "type": "number"
      },
      "sky_row": {
       "type": "number"
      },
      "near_row": {
       "type": "number"
      }
     }
    },
    "max_slide_px": {
     "type": "integer",
     "description": "the largest slide of one card against another the runtime may use, in card pixels; a card holds no pixel that the nearer cards hide at every offset within it"
    },
    "curvature": {
     "type": "object",
     "required": [
      "r_earth_m",
      "k_ref"
     ],
     "additionalProperties": false,
     "properties": {
      "r_earth_m": {
       "type": "number"
      },
      "k_ref": {
       "type": "number"
      }
     }
    },
    "encoding": {
     "type": "object",
     "required": [
      "log_d_min",
      "log_d_max",
      "normal"
     ],
     "additionalProperties": false,
     "properties": {
      "log_d_min": {
       "type": "number"
      },
      "log_d_max": {
       "type": "number"
      },
      "normal": {
       "const": "rt8"
      }
     }
    },
    "cards": {
     "type": "array",
     "minItems": 1,
     "maxItems": 6,
     "items": {
      "type": "object",
      "required": [
       "top",
       "h",
       "near_m",
       "far_m",
       "median_m",
       "colour",
       "geometry"
      ],
      "additionalProperties": false,
      "properties": {
       "top": {
        "type": "integer"
       },
       "h": {
        "type": "integer"
       },
       "near_m": {
        "type": [
         "number",
         "null"
        ]
       },
       "far_m": {
        "type": [
         "number",
         "null"
        ]
       },
       "median_m": {
        "type": "number"
       },
       "colour": {
        "type": "object",
        "required": [
         "file",
         "bytes"
        ],
        "additionalProperties": false,
        "properties": {
         "file": {
          "type": "string"
         },
         "bytes": {
          "type": "integer"
         }
        }
       },
       "geometry": {
        "type": "object",
        "required": [
         "file",
         "bytes"
        ],
        "additionalProperties": false,
        "properties": {
         "file": {
          "type": "string"
         },
         "bytes": {
          "type": "integer"
         }
        }
       }
      },
      "description": "nearest first; the runtime paints the list last to first. top and h place the card back at its rows of the frame; near_m and far_m are the median seam depths, null at the ends."
     }
    },
    "w": {
     "type": "integer"
    },
    "h": {
     "type": "integer"
    },
    "bytes": {
     "type": "integer"
    },
    "attribution": {
     "type": "object",
     "required": [
      "credit_line",
      "licence",
      "dem_source",
      "url"
     ],
     "additionalProperties": false,
     "properties": {
      "credit_line": {
       "type": "string"
      },
      "licence": {
       "type": "string"
      },
      "dem_source": {
       "type": "string"
      },
      "url": {
       "type": "string"
      }
     }
    }
   }
  },
  "index": {
   "type": "object",
   "required": [
    "schema",
    "default",
    "places"
   ],
   "additionalProperties": false,
   "properties": {
    "schema": {
     "const": 1
    },
    "default": {
     "type": "string"
    },
    "places": {
     "type": "object",
     "additionalProperties": {
      "type": "string"
     }
    }
   }
  }
 }
}
