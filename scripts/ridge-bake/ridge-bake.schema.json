{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "ridge-bake manifest v4 and index v1",
 "$defs": {
  "manifest": {
   "type": "object",
   "required": [
    "schema",
    "baker_version",
    "bake_id",
    "place",
    "view",
    "curvature",
    "encoding",
    "material",
    "relief",
    "camera",
    "cards",
    "tiles",
    "bytes",
    "attribution"
   ],
   "additionalProperties": false,
   "properties": {
    "schema": {
     "const": 4
    },
    "baker_version": {
     "type": "integer"
    },
    "bake_id": {
     "type": "string"
    },
    "place": {
     "type": "object",
     "required": [
      "id",
      "name",
      "lat",
      "lon",
      "altitude_km",
      "eye_m",
      "tz"
     ],
     "additionalProperties": false,
     "properties": {
      "id": {
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "lat": {
       "type": "number"
      },
      "lon": {
       "type": "number"
      },
      "altitude_km": {
       "type": "number"
      },
      "eye_m": {
       "type": "number"
      },
      "tz": {
       "type": "string",
       "format": "iana-tz"
      }
     }
    },
    "view": {
     "type": "object",
     "required": [
      "look_az_deg",
      "ring_w",
      "tile_w",
      "tiles",
      "apron",
      "plane_h",
      "px_per_deg_h",
      "px_per_deg_v",
      "exaggeration",
      "horizon_row",
      "sky_row",
      "near_row"
     ],
     "additionalProperties": false,
     "properties": {
      "look_az_deg": {
       "type": "number"
      },
      "ring_w": {
       "const": 6400
      },
      "tile_w": {
       "const": 200
      },
      "tiles": {
       "const": 32
      },
      "apron": {
       "const": 3
      },
      "plane_h": {
       "type": "integer"
      },
      "px_per_deg_h": {
       "type": "number"
      },
      "px_per_deg_v": {
       "type": "number"
      },
      "exaggeration": {
       "type": "number"
      },
      "horizon_row": {
       "type": "number"
      },
      "sky_row": {
       "type": "number"
      },
      "near_row": {
       "type": "number"
      }
     }
    },
    "curvature": {
     "type": "object",
     "required": [
      "r_earth_m",
      "k_ref"
     ],
     "additionalProperties": false,
     "properties": {
      "r_earth_m": {
       "type": "number"
      },
      "k_ref": {
       "type": "number"
      }
     }
    },
    "encoding": {
     "type": "object",
     "required": [
      "log_d_min",
      "log_d_max",
      "h_min_m",
      "h_max_m",
      "normal"
     ],
     "additionalProperties": false,
     "properties": {
      "log_d_min": {
       "type": "number"
      },
      "log_d_max": {
       "type": "number"
      },
      "h_min_m": {
       "type": "number"
      },
      "h_max_m": {
       "type": "number"
      },
      "normal": {
       "const": "rt8-up-walls"
      }
     }
    },
    "material": {
     "type": "object",
     "required": [
      "base",
      "ramps",
      "steep",
      "snow"
     ],
     "additionalProperties": false,
     "properties": {
      "base": {
       "type": "array",
       "minItems": 3,
       "maxItems": 3,
       "items": {
        "type": "number"
       }
      },
      "ramps": {
       "type": "array",
       "items": {
        "type": "object",
        "required": [
         "from_m",
         "to_m",
         "colour"
        ],
        "additionalProperties": false,
        "properties": {
         "from_m": {
          "type": "number"
         },
         "to_m": {
          "type": "number"
         },
         "colour": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
           "type": "number"
          }
         }
        }
       }
      },
      "steep": {
       "type": [
        "object",
        "null"
       ],
       "required": [
        "colour"
       ],
       "additionalProperties": false,
       "properties": {
        "colour": {
         "type": "array",
         "minItems": 3,
         "maxItems": 3,
         "items": {
          "type": "number"
         }
        }
       }
      },
      "snow": {
       "type": [
        "object",
        "null"
       ],
       "required": [
        "from_m",
        "to_m",
        "colour"
       ],
       "additionalProperties": false,
       "properties": {
        "from_m": {
         "type": "number"
        },
        "to_m": {
         "type": "number"
        },
        "colour": {
         "type": "array",
         "minItems": 3,
         "maxItems": 3,
         "items": {
          "type": "number"
         }
        }
       }
      }
     },
     "description": "The place's authored ground material (places.json materials, ridge.check_material), copied here: the client shades the surface's height with it."
    },
    "relief": {
     "type": [
      "object",
      "null"
     ],
     "required": [
      "detail",
      "ridge_removal",
      "ridge_gain",
      "ridge_sharpness",
      "valley_removal",
      "valley_gain",
      "valley_limit",
      "slope_threshold_deg",
      "max_shift_m"
     ],
     "additionalProperties": false,
     "properties": {
      "detail": {
       "type": "number"
      },
      "ridge_removal": {
       "type": "number"
      },
      "ridge_gain": {
       "type": "number"
      },
      "ridge_sharpness": {
       "type": "number"
      },
      "valley_removal": {
       "type": "number"
      },
      "valley_gain": {
       "type": "number"
      },
      "valley_limit": {
       "type": "number"
      },
      "slope_threshold_deg": {
       "type": "number"
      },
      "max_shift_m": {
       "type": [
        "number",
        "null"
       ]
      }
     },
     "description": "The generalisation knobs the terrain was baked with (places.json relief, canonical), null for the survey as it is.  Provenance only: the runtime never reads it."
    },
    "camera": {
     "type": "object",
     "required": [
      "r_max_m",
      "r_max_forward_m"
     ],
     "additionalProperties": false,
     "properties": {
      "r_max_m": {
       "type": "number"
      },
      "r_max_forward_m": {
       "type": "number"
      }
     },
     "description": "r_max_m (every camera angle on its circle) and r_max_forward_m (the camera on its heading) are the offsets up to which the linear slide holds (the fit error at most FIT_PX_MAX card px) for the NEAREST solid terrain (at or beyond the near clip, ridge.NEAR_CLIP_M, 500 m) that each card draws in each tile, not for the tile's median distance_m; a tile whose card 0 draws only near ground (under the clip) is slid at the clip distance (its distance_m) and binds at 500 m. The ground under the clip is drawn by card 0 from the near march and is otherwise not measured."
    },
    "cards": {
     "type": "array",
     "minItems": 1,
     "maxItems": 6,
     "items": {
      "type": "object",
      "required": [
       "near_m",
       "far_m"
      ],
      "additionalProperties": false,
      "properties": {
       "near_m": {
        "type": [
         "number",
         "null"
        ]
       },
       "far_m": {
        "type": [
         "number",
         "null"
        ]
       }
      }
     },
     "description": "nearest first; the runtime paints the list last to first.  near_m and far_m are the median seam depths over the ring, null at the ends."
    },
    "tiles": {
     "type": "array",
     "minItems": 32,
     "maxItems": 32,
     "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
       "type": [
        "object",
        "null"
       ],
       "required": [
        "top",
        "h",
        "distance_m",
        "surface",
        "geometry"
       ],
       "additionalProperties": false,
       "properties": {
        "top": {
         "type": "integer"
        },
        "h": {
         "type": "integer"
        },
        "distance_m": {
         "type": "number"
        },
        "surface": {
         "type": "object",
         "required": [
          "file",
          "bytes"
         ],
         "additionalProperties": false,
         "properties": {
          "file": {
           "type": "string"
          },
          "bytes": {
           "type": "integer"
          }
         }
        },
        "geometry": {
         "type": "object",
         "required": [
          "file",
          "bytes"
         ],
         "additionalProperties": false,
         "properties": {
          "file": {
           "type": "string"
          },
          "bytes": {
           "type": "integer"
          }
         }
        }
       }
      }
     },
     "description": "tiles[t][i] is card i in tile t, or null where the card holds nothing in that tile (the client takes its distance from the neighbouring tiles).  Tile t owns the ring columns [tile_w t, tile_w (t + 1)), column c at azimuth (c + 0.5) / ring_w x 360, 0 = north; its files hold [tile_w t - apron, tile_w (t + 1) + apron), wrapping at the ring's end, and are tile_w + 2 apron columns wide.  top and h place the card's band back at its rows of the frame; distance_m = exp(median ln d) of the card's solid pixels in the tile that are neither wall nor near ground, under the near clip (the interior tile_w columns); a tile whose card draws only near ground gets the clip distance.  surface: RGBA, R G the height of the terrain (16 bit, R high) between encoding.h_min_m and h_max_m, B 255 on wall pixels, A coverage; geometry: R G the normal (walls face up), B the log-distance."
    },
    "bytes": {
     "type": "integer"
    },
    "attribution": {
     "type": "object",
     "required": [
      "credit_line",
      "licence",
      "dem_source",
      "url"
     ],
     "additionalProperties": false,
     "properties": {
      "credit_line": {
       "type": "string"
      },
      "licence": {
       "type": "string"
      },
      "dem_source": {
       "type": "string"
      },
      "url": {
       "type": "string"
      }
     }
    }
   }
  },
  "index": {
   "type": "object",
   "required": [
    "schema",
    "default",
    "places"
   ],
   "additionalProperties": false,
   "properties": {
    "schema": {
     "const": 1
    },
    "default": {
     "type": "string"
    },
    "places": {
     "type": "object",
     "additionalProperties": {
      "type": "string"
     }
    }
   }
  }
 }
}
